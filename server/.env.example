# MovieBox server — minimal configuration.
# Copy to .env and fill in. Start with:  node --env-file=.env src/index.js

# ---- Required -------------------------------------------------------------

# Shared secret for the first admin (device logins use their own tokens).
# Generate with:  openssl rand -hex 32
API_TOKEN=

# ---- Core -----------------------------------------------------------------

HOST=127.0.0.1
PORT=3200
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=moviebox

# Where video files and generated artefacts live. The first admin uses this folder
# directly; other accounts live under <MEDIA_DIR>/users/<id>/.
MEDIA_DIR=/srv/moviebox/media
BACKUP_DIR=/srv/moviebox/backups

# ---- External binaries ----------------------------------------------------

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YTDLP_PATH=yt-dlp
# YTDLP_EXTRA_ARGS=--cookies /srv/moviebox/youtube-cookies.txt

# ---- Transcoding ----------------------------------------------------------

# No GPU on this install: a 1080p ceiling and one job at a time keep CPU honest.
MAX_TRANSCODE_HEIGHT=1080
TRANSCODE_CONCURRENCY=1

# ---- Metadata -------------------------------------------------------------

# TMDB is the primary metadata source (free API key at themoviedb.org).
# TMDB_API_KEY=
TMDB_LANGUAGE=de-DE

# Optional: OpenSubtitles (free API key at opensubtitles.com).
# OPEN_SUBTITLES_API_KEY=

# ---- nginx X-Accel-Redirect ----------------------------------------------

# Set when nginx should serve video files directly (via X-Accel-Redirect) after
# the Node server has checked the token. Matches the "internal" location block.
# ACCEL_REDIRECT_PREFIX=/_moviebox_media
